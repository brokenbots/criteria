[Unit]
Description=Criteria Remote Adapter (TypeScript)
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=5
Environment="NODE_ENV=production"
Environment="CRITERIA_REMOTE_HOST=wss://criteria.example.com:7778"
Environment="CRITERIA_REMOTE_TOKEN_FILE=/etc/criteria/token"
ExecStart=/usr/bin/bun run /opt/criteria-adapter/dist/index.js
WorkingDirectory=/opt/criteria-adapter
User=criteria-adapter
Group=criteria-adapter

[Install]
WantedBy=multi-user.target
