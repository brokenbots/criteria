go 1.27

// go1.27.0's standard library carries GO-2026-6809/6603/6599-class findings;
// 1.27.3 shipped every fix except GO-2026-6859 (net/http MaxBytesReader
// header race, reachable from the sdk/workflow modules); 1.27.4 ships every
// fix. This matches the root go.mod toolchain and both image builders
// (Dockerfile.peer's golang:1.27.4-bookworm and Dockerfile.runtime's
// golang:1.27.4-alpine). Workspace-mode commands take the toolchain from
// here, not from root go.mod.
toolchain go1.27.4

use (
	.
	./sdk
	./tools
	./workflow
)
