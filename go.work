go 1.27

// go1.27.0's standard library carries GO-2026-6809/6603/6599-class findings;
// 1.27.3 shipped every earlier fix, and 1.27.4 adds the net/http fix for
// GO-2026-6859 (matches root go.mod toolchain + the Dockerfile.peer builder
// floor). Workspace-mode commands take the toolchain from here, not from
// root go.mod.
toolchain go1.27.4

use (
	.
	./sdk
	./tools
	./workflow
)
