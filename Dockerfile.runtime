# syntax=docker/dockerfile:1.7

FROM golang:1.26-alpine AS build

WORKDIR /src

RUN apk add --no-cache make git

ENV CGO_ENABLED=0

COPY . .

# CRITERIA_VERSION is REQUIRED: the exact version string stamped into the
# binary (the release tag, e.g. v0.5.30, or a git-describe string for local
# dev builds). There is deliberately NO in-image fallback: the build context
# carries no .git (see .dockerignore), so a describe-based default would
# silently stamp an empty version — an image whose engine version is ambiguous
# must not build at all. Same fail-closed policy as criteria-base/Dockerfile.
ARG CRITERIA_VERSION=""
RUN test -n "${CRITERIA_VERSION}" || { echo "CRITERIA_VERSION is required (e.g. v0.5.30, or a git-describe string for local builds)"; exit 1; } \
    && go work sync \
    && make build VERSION="${CRITERIA_VERSION}" \
    && make plugins \
    && mkdir -p /out/bin \
    && cp -a bin/. /out/bin/

FROM alpine:3.20

RUN apk add --no-cache ca-certificates git \
    && addgroup -S -g 10001 criteria \
    && adduser -S -D -h /home/criteria -u 10001 -G criteria criteria \
    && mkdir -p /workspace /home/criteria/.criteria/plugins \
    && chown -R criteria:criteria /workspace /home/criteria

COPY --from=build /out/bin/ /usr/local/bin/

RUN cp /usr/local/bin/criteria-adapter-* /home/criteria/.criteria/plugins/ \
    && chown criteria:criteria /home/criteria/.criteria/plugins/criteria-adapter-*

ENV HOME=/home/criteria

USER criteria
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/criteria"]
