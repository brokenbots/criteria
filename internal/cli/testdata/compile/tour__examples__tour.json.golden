{
  "name": "tour",
  "initial_state": "boot",
  "target_state": "done",
  "policy": {
    "MaxTotalSteps": 50,
    "MaxStepRetries": 0,
    "MaxVisitsWarnThreshold": 200
  },
  "adapters": [
    {
      "type": "shell",
      "name": "default",
      "on_crash": "fail",
      "config_keys": null
    }
  ],
  "steps": [
    {
      "name": "boot",
      "adapter": "shell.default",
      "timeout": "10s",
      "input_keys": [
        "command"
      ],
      "allow_tools": null,
      "outcomes": [
        {
          "name": "failure",
          "next": "aborted"
        },
        {
          "name": "success",
          "next": "process_each"
        }
      ]
    },
    {
      "name": "process_each",
      "adapter": "shell.default",
      "timeout": "30s",
      "input_keys": [
        "command"
      ],
      "allow_tools": null,
      "outcomes": [
        {
          "name": "all_succeeded",
          "next": "fan_out"
        },
        {
          "name": "any_failed",
          "next": "aborted"
        }
      ]
    },
    {
      "name": "fan_out",
      "adapter": "shell.default",
      "input_keys": [
        "command"
      ],
      "allow_tools": null,
      "outcomes": [
        {
          "name": "all_succeeded",
          "next": "settle"
        },
        {
          "name": "any_failed",
          "next": "aborted"
        }
      ]
    },
    {
      "name": "finish",
      "adapter": "shell.default",
      "timeout": "10s",
      "input_keys": [
        "command"
      ],
      "allow_tools": null,
      "outcomes": [
        {
          "name": "failure",
          "next": "aborted"
        },
        {
          "name": "success",
          "next": "done"
        }
      ]
    }
  ],
  "states": [
    {
      "name": "aborted",
      "terminal": true,
      "success": false
    },
    {
      "name": "done",
      "terminal": true,
      "success": true
    }
  ],
  "outputs": [
    {
      "name": "label",
      "type": "string",
      "description": "The label used for this run."
    }
  ],
  "switches": [
    {
      "name": "decide",
      "conditions": [
        {
          "match": "var.label == \"tour\"",
          "next": "finish"
        }
      ],
      "default_next": "aborted"
    }
  ],
  "step_order": [
    "boot",
    "process_each",
    "fan_out",
    "finish"
  ],
  "plugins_required": [
    "shell"
  ],
  "metadata": {
    "schema_version": 1
  }
}
