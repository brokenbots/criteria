# syntax=docker/dockerfile:1

# Build a peer-mode container image for a Criteria v2 adapter (ADR-0007).
#
# Unlike images/remote-adapters/Dockerfile (the legacy runner image), this
# image packages the criteria engine itself. The entrypoint is
# `criteria peer`: the engine-side peer supervisor resolves and launches the
# adapter as a local go-plugin child, serves the FULL v2 AdapterService
# contract plus PeerService supervision (Supervise / Control) on the
# phone-home connection, and keeps the child alive across host disconnects
# with a bounded journal that replays crash evidence after reconnects.
#
# Required build arguments:
#   ADAPTER_NAME     - "shell", "copilot", "claude-agent", ...
#   ADAPTER_VERSION  - Semver without leading v (e.g. "0.5.2")
#   CRITERIA_VERSION - Exact criteria version stamped into the engine binary
#                      (e.g. "v0.5.30", or a git-describe string for local
#                      builds). There is deliberately NO in-image fallback:
#                      the build context carries no .git (see .dockerignore),
#                      so a describe-based default would silently stamp an
#                      empty version. Same fail-closed policy as
#                      Dockerfile.runtime — the peer handshake advertises
#                      criteria_version, so an ambiguous version must not
#                      build at all.
#
# Optional build arguments:
#   BASE_IMAGE       - Runtime base image (default: alpine:3.20)
#   COPILOT_VERSION  - npm version of @github/copilot for copilot images
#                      (default: 1.0.82)
#
# Example:
#   docker buildx build \
#     --build-arg ADAPTER_NAME=shell \
#     --build-arg ADAPTER_VERSION=0.5.2 \
#     --build-arg CRITERIA_VERSION=v0.5.30 \
#     -f images/remote-adapters/Dockerfile.peer \
#     -t ghcr.io/brokenbots/criteria-adapter-shell-peer:0.5.2 .

ARG ADAPTER_NAME=shell
ARG ADAPTER_VERSION=0.0.0
ARG CRITERIA_VERSION=""
ARG BASE_IMAGE=alpine:3.20
ARG COPILOT_VERSION=1.0.82

FROM golang:1.26.6-bookworm AS builder

ARG ADAPTER_NAME
ARG ADAPTER_VERSION
ARG CRITERIA_VERSION

WORKDIR /src

COPY go.mod go.sum ./
COPY specdata.go ./
COPY docs/ docs/
COPY sdk/ sdk/
COPY workflow/ workflow/
COPY events/ events/
COPY internal/ internal/
COPY cmd/ cmd/

ENV CGO_ENABLED=0
ENV GOWORK=off

# The engine binary, built from this repo. The version stamp is required and
# exact (see header comment); `-X` writes it into workflow/version.Version.
# specdata.go embeds docs/LANGUAGE-SPEC.md + docs/llm/*, so both must be in
# the build context (top-level *.md files are excluded by .dockerignore, but
# Docker's ignore patterns do not recurse into docs/).
RUN test -n "${CRITERIA_VERSION}" || { echo "CRITERIA_VERSION is required (e.g. v0.5.30, or a git-describe string for local builds)"; exit 1; } \
    && go build -trimpath -ldflags="-s -w -X github.com/brokenbots/criteria/workflow/version.Version=${CRITERIA_VERSION}" \
    -o /usr/local/bin/criteria ./cmd/criteria

# Pull the requested adapter binary from its own public module.
RUN GOPROXY=direct GOSUMDB=off go install "github.com/brokenbots/criteria-adapter-${ADAPTER_NAME}@v${ADAPTER_VERSION}"

FROM ${BASE_IMAGE}

ARG ADAPTER_NAME
ARG ADAPTER_VERSION
ARG COPILOT_VERSION

USER root

# Base packages for every peer adapter: CA certificates for TLS back to the
# host, plus the sandbox tools the develop/review agents invoke through
# the shell adapter (CRI-272: git, ripgrep, jq, gh CLI, ssh, bash, procps).
RUN case "$(cat /etc/os-release 2>/dev/null | grep -E '^ID=' | cut -d= -f2 | tr -d '"')" in \
      alpine) apk add --no-cache ca-certificates git github-cli openssh-client bash procps findutils ripgrep jq curl ;; \
      debian) apt-get update && apt-get install -y --no-install-recommends ca-certificates git gh openssh-client bash procps findutils ripgrep jq curl && rm -rf /var/lib/apt/lists/* ;; \
    esac

# The copilot adapter requires the GitHub Copilot CLI on PATH.
RUN if [ "$ADAPTER_NAME" = "copilot" ]; then \
      apk add --no-cache nodejs npm \
      && npm install --global "@github/copilot@${COPILOT_VERSION}" \
      && npm cache clean --force; \
    fi

RUN addgroup -g 10001 -S criteria 2>/dev/null || groupadd --system --gid 10001 criteria && \
    adduser -u 10001 -S criteria -G criteria 2>/dev/null || \
    useradd --system --uid 10001 --gid criteria --home-dir /home/criteria --create-home criteria

COPY --from=builder /usr/local/bin/criteria /usr/local/bin/
COPY --from=builder /go/bin/criteria-adapter-${ADAPTER_NAME} /usr/local/bin/

# The peer resolves its child from CRITERIA_ADAPTER_* (same precedence as the
# legacy runner), and every CRITERIA_REMOTE_* value is scrubbed from the
# child's environment by the peer itself.
ENV CRITERIA_ADAPTER_NAME=${ADAPTER_NAME} \
    CRITERIA_ADAPTER_BINARY=/usr/local/bin/criteria-adapter-${ADAPTER_NAME} \
    CRITERIA_ADAPTER_VERSION=${ADAPTER_VERSION} \
    HOME=/home/criteria

USER criteria
WORKDIR /home/criteria

ENTRYPOINT ["/usr/local/bin/criteria", "peer"]